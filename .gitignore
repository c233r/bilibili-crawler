# ═══════════════════════════════════════════════════════════════
#  凭据 —— 绝对不要提交（这是本仓库最重要的一条规则）
# ═══════════════════════════════════════════════════════════════
cookie.txt
cookies.txt
cookies.json
*.cookie

# 本地配置（含 API Key 与本机绝对路径）；config.example.json 是模板，需要提交
config.json
!config.example.json

# ═══════════════════════════════════════════════════════════════
#  运行时产物
# ═══════════════════════════════════════════════════════════════
downloads/
data/
output/
logs/
*.log

# VLM 筛选的运行时输出（含本机绝对路径与视频标题）；
# 格式示例见 examples/result.example.json 与 examples/statistics.example.json
result.json
statistics.json

# SQLite 断点续传数据库
*.db
*.sqlite
*.db-shm
*.db-wal

# ═══════════════════════════════════════════════════════════════
#  Python
# ═══════════════════════════════════════════════════════════════
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
env/

# ═══════════════════════════════════════════════════════════════
#  编辑器 / 系统
# ═══════════════════════════════════════════════════════════════
.vscode/
.idea/
.trae/
*.swp
*~
.DS_Store
Thumbs.db
